{
  "name": "campus-lost-found",
  "version": "2.0.0",
  "private": true,
  "description": "Campus Lost & Found — a two-sided lost-and-found board built with Next.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "e2e": "node --env-file-if-exists=.env.local scripts/e2e.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.24.6",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0"
  }
}
